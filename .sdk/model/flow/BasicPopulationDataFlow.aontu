# BasicPopulationDataFlow

main: kit: flow: BasicPopulationDataFlow:
{
  entity: "population_data",
  kind: "basic",
  name: "BasicPopulationDataFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "population_data_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "population_data_ref01",
        srcdatavar: "population_data_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-population_data_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPopulationDataFlow"
}